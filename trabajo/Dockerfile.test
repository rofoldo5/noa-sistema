FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements.txt requirements-test.txt ./
RUN pip install -r requirements-test.txt && useradd --uid 10001 --create-home appuser
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
COPY tests ./tests
RUN chmod -R a+rX /srv/app /srv/migrations /srv/tests && chmod a+r /srv/alembic.ini
USER appuser
RUN alembic show 0001_trabajo
CMD ["python", "-m", "pytest", "-q", "-o", "cache_dir=/tmp/pytest-cache"]
