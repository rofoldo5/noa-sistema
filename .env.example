# Plantilla local. NO usar estos marcadores como secretos reales.
# Para Portainer Git Stack, carga estos valores en Stack > Environment variables.
IDENTITY_POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARS
IDENTITY_JWT_SECRET=REPLACE_WITH_96_HEX_CHARS
WORK_POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARS
# En una instalación nueva, el primer departamento normalmente tendrá ID 1.
# Si se restaura Identidad, coloca aquí el ID real del departamento piloto.
WORK_DEPARTMENT_ID=1
MEDIA_PREVIEW_SECRET=REPLACE_WITH_96_HEX_CHARS
IDENTITY_API_PORT=18081
WORK_API_PORT=18082
NOA_FRONTEND_PORT=18083
MAX_ATTACHMENT_BYTES=104857600
